# キットはリポジトリの外（../github-core-clone-01-kit）に置く。万一中に置いても入れない
github-core-clone-01-kit/
*-kit/
*.tar.gz

# Rust のビルド成果物
target/

# 開発用ネイティブバイナリ（コミット禁止）。提出用は forge-linux-x64 だけ
forge-*
!forge-linux-x64

# ローカル採点のログ
.grade/

# 秘密情報（絶対にコミットしない）
.env
.env.*
*keypair*.json
id.json
wallet.json
*.pem
*.key

# 作業記録の束（提出時に別途アップロードする）
*.bundle
transcripts/

# その他
node_modules/
.DS_Store
*.cpuprofile
*.heapprofile
perf.data*
